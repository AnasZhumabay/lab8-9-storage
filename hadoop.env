CORE_CONF_fs_defaultFS=hdfs://namenode:9000
HDFS_CONF_dfs_replication=2

# --- Additions beyond the lab handout (safe to keep) ---------------------------
# bde2020 naming rule: "___" -> "-", "__" -> "_", "_" -> "."

# Declare a stopped DataNode dead after ~90 s instead of the default ~10.5 min
# (dead timeout = 2 * recheck-interval + 10 * heartbeat-interval = 2*30s + 10*3s).
HDFS_CONF_dfs_namenode_heartbeat_recheck___interval=30000
HDFS_CONF_dfs_heartbeat_interval=3

# Enable WebHDFS and skip permission checks so the lab user can write freely.
HDFS_CONF_dfs_webhdfs_enabled=true
HDFS_CONF_dfs_permissions_enabled=false

# DataNodes register by container hostname instead of IP.
HDFS_CONF_dfs_namenode_datanode_registration_ip___hostname___check=false
